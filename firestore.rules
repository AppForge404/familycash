rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Hanya akun yang emailnya ada di daftar ini yang boleh membaca/menulis.
    // GANTI dengan email anggota keluarga Anda (huruf kecil semua).
    match /{document=**} {
      allow read, write: if request.auth != null
        && request.auth.token.email in [
          'suami@email.com',
          'istri@email.com'
        ];
    }
  }
}
